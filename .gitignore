# Local secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python environment and generated caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Frontend dependencies and builds
node_modules/
dist/
build/
coverage/

# Local runtime artifacts
*.db
*.db-*
*.sqlite
*.sqlite3
*.log
logs/
mlruns/
mlartifacts/
runtime/
data/uploads/*
!data/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Models are initialized inside the persistent Docker volume
backend/models/*
!backend/models/.gitkeep

# Office and presentation generation locks
~$*
.slide_jobs.json.lock
.slide_run_state.json.lock

# Built dashboard is generated by the Docker frontend stage
backend/dashboard/

# TypeScript incremental compilation cache
*.tsbuildinfo
.chart-data-*

# Browser test reports, traces and local authentication state
playwright-report/
blob-report/
test-results/
.test-results/
**/playwright/.auth/

# Additional Python analysis caches
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
