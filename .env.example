# 호스트 접속 포트. 컨테이너 내부 API 포트는 8099입니다.
GROUNDWATCH_PORT=8100
# 실제 값은 .env에만 저장합니다. 기상청은 ASOS 일자료 활용 승인이 필요합니다.
SEOUL_OPEN_DATA_KEY=
KMA_ASOS_SERVICE_KEY=

# 승인된 API 매핑이 있을 때만 매일 10시 이후 최근7일 수집
GROUNDWATCH_COLLECTION_ENABLED=true

# true: 원본과 별도 namespace에서 오늘까지 과제용 합성 확장·학습
GROUNDWATCH_CURRENT_EXTENSION=true

# 전국 수집용 키. 실제 값은 .env에만 저장합니다.
GIMS_API_KEY=
GIMS_STATION_API_KEY=
KMA_APIHUB_KEY=
# 승인된 실측 관측소·모델이 있을 때만 명시적으로 활성화
GROUNDWATCH_NATIONAL_SCHEDULER_ENABLED=true

# AWS 관측 강수 자동 갱신. 승인된 API허브 키가 필요합니다.
GROUNDWATCH_WEATHER_COLLECTION_ENABLED=true

# 확보된 실측·명시적 실험 매핑으로 초기 모델 평가. 운영 승격은 별도 조건입니다.
GROUNDWATCH_EXPERIMENTAL_MODELS_ENABLED=true
GROUNDWATCH_EXPERIMENTAL_TRAIN_EPOCHS=30

# 같은 시간 분할로 기본·강수보강 모델의 장마 성능 평가(운영 승격 아님)
GROUNDWATCH_SEASONAL_EVALUATION_ENABLED=true

# 등록된 실측·명시적 매핑만 매일 갱신·감시합니다. 운영 승인과는 별개입니다.
GROUNDWATCH_NATIONAL_OBSERVATION_COLLECTION_ENABLED=true
GROUNDWATCH_EXPERIMENTAL_MONITORING_ENABLED=true
